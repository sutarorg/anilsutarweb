<?xml version="1.0" encoding="UTF-8"?>
<!--
    Please refer to machine.config.comments for a description and
    the default values of each configuration section.

    For a full documentation of the schema please refer to
    http://go.microsoft.com/fwlink/?LinkId=42127

    To improve performance, machine.config should contain only those
    settings that differ from their defaults.
-->
<configuration>

  <!--
      Default documents: index.php is the home page of this site.
      IIS does not look for index.php out of the box, so it is listed first
      here - a request for "/" is then served by index.php, exactly like on a
      PHP host with `DirectoryIndex index.php`.
      (The static deployment on Vercel gets the same result from
      scripts/build-vercel.mjs, which writes home page HTML to public/index.html.)
  -->
  <system.webServer>
    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="index.php" />
        <add value="index.html" />
        <add value="home.html" />
      </files>
    </defaultDocument>
  </system.webServer>

  <system.web>
    <compilation tempDirectory="e:\Inetpub\anilsutar.com\tmp" />
  </system.web>
</configuration>
